## Canonical text of every item of the city for a seed (tests: client vs server): one line per item, cm integers.
static func items_digest(hf: HeightFunction) -> String:
	var hc := HashingContext.new()
	hc.start(HashingContext.HASH_SHA256)
	var n := 0
	for key in chunk_keys():
		var cx := WorldConst.key_cx(key)
		var cz := WorldConst.key_cz(key)
		for e in chunk_items(hf, cx, cz, func(x: float, z: float) -> float: return hf.height_at(x, z)):
			hc.update(item_line(e).to_utf8_buffer())
			n += 1
	return "%s items=%d" % [hc.finish().hex_encode(), n]


## Digest of the seeded dressing of the first `n` enterable lots (C1 acceptance «vestido de 50 parcelas»): per lot
## its wid, its door's wid (KitDoor.wid_for) and each loot container's wid and table (LootSpawns: hash64(seed,
## GEN_LOOT, lot wid, i + 1); the table is the lot's hash pick) — what every peer builds without replicating a node.
static func lot_digest(seed_v: int, n: int = 50) -> String:
	var hc := HashingContext.new()
	hc.start(HashingContext.HASH_SHA256)
	var done := 0
	for id in building_ids():
		if done >= n:
			break
		var b: Dictionary = _buildings[id]
		if not bool(b["ent"]):
			continue
		var bw := int(b["wid"])
		var fam := str(b["fam"])
		var line := "%d %x %x" % [int(id), bw, KitDoor.wid_for(seed_v, bw, 0)]
		var tables: Array = BuildingAssembler.SHOP_TABLES.get(fam, [&"house"])
		var sp: Array = BuildingAssembler.spawns(BuildingAssembler.spec(fam, int(b["var"])))
		for i in sp.size():
			var tbl: StringName = tables[posmod(int(WorldConst.hash64(bw, 17, i) & 0xFFFF), tables.size())]
			line += " %x:%s" % [WorldConst.hash64(seed_v, Loot.GEN_LOOT, bw, i + 1), tbl]
		hc.update((line + "\n").to_utf8_buffer())
		done += 1
	return "%s lots=%d" % [hc.finish().hex_encode(), done]


static func item_line(e: Dictionary) -> String:
	var p: Vector2 = e["pos"]
	var what := str(e.get("model", e.get("family", "")))
	if int(e["k"]) == Kind.BUILDING:
		what = "%s/%d/%d/%d/%d" % [e["fam"], int(e["var"]), int(e["floors"]), int(e["pal"]), 1 if bool(e["ent"]) else 0]
	return "%d %d %s %s %d %d %d %d %d\n" % [int(e["k"]), int(e["id"]), what, str(e.get("variant", "")),
		int(round(p.x * 100.0)), int(round(p.y * 100.0)), int(round(float(e.get("y", 0.0)) * 100.0)), int(round(float(e.get("yaw", 0.0)) * 100.0)), int(e["wid"])]
