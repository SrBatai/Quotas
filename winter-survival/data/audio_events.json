{
  "version": 1,
  "doc": "S1 event table (docs/AUDIO.md §4). files = res://assets/audio/<path>; a string ending in * is a glob expanded against assets/audio/manifest.json. Fields: type (simple | shot | footstep | surface | hit | melee_swing | stinger), bus, mode (3d | 2d), volume_db, pitch_rand (± fraction), vol_rand_db (±), max_distance (m, 3D: beyond it the event is not played), unit_size (m at 0 dB, inverse-distance), lpf_hz (distance low-pass cutoff at max_distance), priority (0–100, voice stealing), max_instances, cooldown (s between two plays of the event), group (a voice budget of the groups table: nearest first), loop, follow [{event, delay}], duck {bus, db, seconds}.",
  "defaults": {"bus": "World", "mode": "3d", "volume_db": 0.0, "pitch_rand": 0.04, "vol_rand_db": 1.5, "max_distance": 40.0,
    "unit_size": 5.0, "lpf_hz": 5000.0, "priority": 50, "max_instances": 4, "cooldown": 0.0},
  "groups": {
    "zombie_voice": {"max": 6, "doc": "zombie vocalisations: at most 6 at once, the nearest win (GDD §14: 8 voices, we keep 2 spare for wolves / specials)"},
    "zombie_step": {"max": 8},
    "footsteps": {"max": 10},
    "impacts": {"max": 10}
  },
  "silent": {
    "reload_pistol": "server-side hook (Gunplay.reload): the reload is heard through the anim events of the reload clip (anim table below) on every client, the owner included",
    "reload_longgun": "server-side hook (Gunplay.reload): the reload steps come from the clip's anim events",
    "reload_bow": "server-side hook (Gunplay.reload): the bow has no reload (Bow_Draw events play bow_draw)",
    "ui_hover": "reserved by the HUD doc (§5.6: hover makes no sound)"
  },
